# mneme-core uuid tests — the 1.2.3 codec (mneme_core_uuid_to_string / _to_hex / _parse / _parse_stored) and the
# pooled v4 entropy. rust-old has no uuid tests of its own (it uses the uuid crate); the parse cases mirror what
# `Uuid::parse_str` accepts and rejects.
include "src/core_uuid.cyr"

fn _u(s): i64 { return mneme_core_uuid_parse(str_from(s)); }

fn main() {
    alloc_init();
    test_group("core_uuid");

    var u = mneme_core_uuid_v4();
    var hy = mneme_core_uuid_to_string(u);
    assert_eq(str_len(hy), 36, "to_string is 36 chars");
    assert_eq(load8(str_data(hy) + 8), 45, "hyphen at 8");
    assert_eq(load8(str_data(hy) + 13), 45, "hyphen at 13");
    assert_eq(load8(str_data(hy) + 18), 45, "hyphen at 18");
    assert_eq(load8(str_data(hy) + 23), 45, "hyphen at 23");
    assert_eq(load8(str_data(hy) + 14), 52, "version nibble 4");
    assert_eq(str_len(mneme_core_uuid_to_hex(u)), 32, "to_hex is 32 chars");

    # the four forms Rust's Uuid::parse_str accepts all round-trip
    assert_eq(mneme_core_uuid_eq(mneme_core_uuid_parse(hy), u), 1, "hyphenated round-trips");
    assert_eq(mneme_core_uuid_eq(mneme_core_uuid_parse(mneme_core_uuid_to_hex(u)), u), 1, "simple form round-trips");
    var br = str_builder_new();
    str_builder_putc(br, 123); str_builder_add(br, hy); str_builder_putc(br, 125);
    assert_eq(mneme_core_uuid_eq(mneme_core_uuid_parse(str_builder_build(br)), u), 1, "braced form parses");
    var urn = str_builder_new();
    str_builder_add_cstr(urn, "urn:uuid:"); str_builder_add(urn, hy);
    assert_eq(mneme_core_uuid_eq(mneme_core_uuid_parse(str_builder_build(urn)), u), 1, "URN form parses");
    var a = _u("67e55044-10b1-426f-9247-bb680e5fe0c8");
    assert_eq(mneme_core_uuid_eq(a, _u("67E55044-10B1-426F-9247-BB680E5FE0C8")), 1, "hex is case-insensitive");
    assert_eq(str_eq_cstr(mneme_core_uuid_to_string(a), "67e55044-10b1-426f-9247-bb680e5fe0c8"), 1, "formats lowercase");

    # what parse_str rejects
    assert_eq(_u("not-a-uuid"), 0, "garbage -> 0");
    assert_eq(_u("67e55044-10b1-426f-9247-bb680e5fe0c"), 0, "35 chars -> 0");
    assert_eq(_u("67e55044x10b1-426f-9247-bb680e5fe0c8"), 0, "no hyphen at 8 -> 0");
    assert_eq(_u("67e55044-10b1-426f-9247-bb680e5fe0cg"), 0, "non-hex digit -> 0");
    assert_eq(_u("{67e55044-10b1-426f-9247-bb680e5fe0c8]"), 0, "mismatched brace -> 0");
    assert_eq(_u("67e5504410b1426f9247bb680e5fe0c"), 0, "31 hex -> 0");
    assert_eq(mneme_core_uuid_parse(0), 0, "parse(0) -> 0");

    # a 0 handle is safe everywhere (1.2.3: it was loaded through — the `mneme serve` crash)
    assert_eq(str_len(mneme_core_uuid_to_string(0)), 0, "to_string(0) is empty, not a read of address 0");
    assert_eq(mneme_core_uuid_eq(0, 0), 1, "eq(0, 0)");
    assert_eq(mneme_core_uuid_eq(0, u), 0, "eq(0, u)");
    assert_eq(mneme_core_uuid_eq(u, 0), 0, "eq(u, 0)");
    var nil = mneme_core_uuid_nil();
    assert_eq(str_eq_cstr(mneme_core_uuid_to_string(nil), "00000000-0000-0000-0000-000000000000"), 1, "nil uuid");
    assert_eq(mneme_core_uuid_eq(mneme_core_uuid_parse_stored(str_from("corrupt")), nil), 1, "a corrupt stored id reads as nil");

    # pooled entropy: 600 ids cross two pool refills (256 ids per 4 KB) and are all distinct
    var ids = vec_new();
    var i = 0;
    while (i < 600) { vec_push(ids, mneme_core_uuid_v4()); i = i + 1; }
    var dup = 0;
    i = 0;
    while (i < 600) {
        var j = i + 1;
        while (j < 600) { if (mneme_core_uuid_eq(vec_get(ids, i), vec_get(ids, j)) == 1) { dup = dup + 1; } j = j + 1; }
        i = i + 1;
    }
    assert_eq(dup, 0, "600 pooled v4 ids are distinct");
    var bad_version = 0;
    i = 0;
    while (i < 600) { if ((load8(vec_get(ids, i) + 6) >> 4) != 4) { bad_version = bad_version + 1; } i = i + 1; }
    assert_eq(bad_version, 0, "every pooled id is version 4");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
