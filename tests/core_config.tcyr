# mneme-core config tests — ported from rust-old/crates/mneme-core/src/config.rs.
# bayan (TOML) is a carve — must be explicitly included even under `cyrius test`.
include "lib/bayan.cyr"
include "src/core_uuid.cyr"
include "src/core_config.cyr"

fn main() {
    alloc_init();
    test_group("core_config");

    # default_config_is_empty
    var config = mneme_core_config_default();
    assert_eq(mneme_core_config_default_vault(config), 0, "default_vault is None");
    assert_eq(vec_len(mneme_core_config_vaults(config)), 0, "vaults empty");
    var cr = mneme_core_config_context_retrieval(config);
    assert_eq(mneme_core_context_enabled(cr), 1, "context enabled");
    assert_eq(mneme_core_context_query_weight(cr), f64_parse("0.7"), "query_weight 0.7");
    assert_eq(mneme_core_context_buffer_capacity(cr), 7, "buffer_capacity 7");

    # vault_config_entry_serde_roundtrip
    var entry = mneme_core_vault_entry_new(str_from("work"), str_from("/home/user/work-notes"), str_from("Work notes"), f64_parse("1.5"));
    var parsed = mneme_core_vault_entry_from_toml(mneme_core_vault_entry_to_toml(entry));
    assert(str_eq(mneme_core_vault_entry_name(parsed), str_from("work")), "roundtrip name");
    assert_eq(mneme_core_vault_entry_search_weight(parsed), f64_parse("1.5"), "roundtrip search_weight 1.5");

    # vault_info_new_defaults
    var info = mneme_core_vault_info_new(str_from("test"), str_from("/tmp/test"));
    assert(str_eq(mneme_core_vault_info_name(info), str_from("test")), "vault info name");
    assert_eq(mneme_core_vault_info_search_weight(info), f64_parse("1.0"), "vault info weight 1.0");
    assert_eq(mneme_core_vault_info_is_default(info), 0, "vault info not default");

    # full_config_serde_roundtrip
    var full = mneme_core_config_default();
    store64(full, str_from("work"));   # default_vault = Some("work")
    var vs = mneme_core_config_vaults(full);
    vec_push(vs, mneme_core_vault_entry_new(str_from("work"), str_from("/work"), 0, f64_parse("1.0")));
    vec_push(vs, mneme_core_vault_entry_new(str_from("personal"), str_from("/personal"), str_from("Personal stuff"), f64_parse("0.5")));
    var rt = mneme_core_config_from_toml(mneme_core_config_to_toml(full));
    assert(str_eq(mneme_core_config_default_vault(rt), str_from("work")), "full roundtrip default_vault");
    assert_eq(vec_len(mneme_core_config_vaults(rt)), 2, "full roundtrip vaults len 2");
    assert(str_eq(mneme_core_embedding_backend(mneme_core_config_embedding(rt)), str_from("auto")), "full roundtrip backend auto");

    # ── TOML escaping ──────────────────────────────────────────────────────
    # Before 1.1.3 these values were written raw between literal quotes, so each
    # of them emitted malformed TOML and lost data on the way back in. Rust got
    # this right for free via toml::to_string; the port did not.
    #
    # ⚠ These also pin the mneme-escapes/mneme-unescapes contract against bayan,
    # which does NOT unescape TOML basic strings. If bayan ever starts doing so,
    # these assertions fail — deliberately. Fix both sides together.
    var q = mneme_core_vault_entry_new(str_from("say \"hi\""), str_from("/tmp/a\\b"), str_from("line1\nline2"), f64_parse("1.0"));
    var qt = mneme_core_vault_entry_to_toml(q);
    var qr = mneme_core_vault_entry_from_toml(qt);
    assert(str_eq(mneme_core_vault_entry_name(qr), str_from("say \"hi\"")), "toml escape: quote in name roundtrips");
    assert(str_eq(mneme_core_vault_entry_path(qr), str_from("/tmp/a\\b")), "toml escape: backslash in path roundtrips");
    assert(str_eq(mneme_core_vault_entry_description(qr), str_from("line1\nline2")), "toml escape: newline in description roundtrips");

    # The emitted TOML must actually carry the escapes, not the raw bytes —
    # otherwise the roundtrip could pass by two cancelling bugs.
    assert(str_contains(qt, "\\\"hi\\\""), "toml escape: emitted quote is backslash-escaped");
    assert(str_contains(qt, "line1\\nline2"), "toml escape: emitted newline is \\n, not a literal break");
    assert_eq(str_index_of(qt, 10) > 0, 1, "toml escape: emitted TOML still has real line breaks between pairs");

    # A tab and a control byte: TOML forbids a bare control char in a basic string.
    var ctl = mneme_core_vault_entry_new(str_from("a\tb"), str_from("/p"), 0, f64_parse("1.0"));
    var ctlr = mneme_core_vault_entry_from_toml(mneme_core_vault_entry_to_toml(ctl));
    assert(str_eq(mneme_core_vault_entry_name(ctlr), str_from("a\tb")), "toml escape: tab in name roundtrips");

    # Non-ASCII must pass through untouched (load8 is zero-extended, so a UTF-8
    # continuation byte must not be mistaken for a control character).
    var u = mneme_core_vault_entry_new(str_from("Résumé — notes"), str_from("/p"), 0, f64_parse("1.0"));
    var ur = mneme_core_vault_entry_from_toml(mneme_core_vault_entry_to_toml(u));
    assert(str_eq(mneme_core_vault_entry_name(ur), str_from("Résumé — notes")), "toml escape: UTF-8 passes through intact");

    # Whole-config roundtrip with a quote in default_vault and a vault name.
    var ec = mneme_core_config_default();
    store64(ec, str_from("we\"ird"));
    vec_push(mneme_core_config_vaults(ec), mneme_core_vault_entry_new(str_from("a\"b"), str_from("/x\\y"), 0, f64_parse("1.0")));
    var ecr = mneme_core_config_from_toml(mneme_core_config_to_toml(ec));
    assert(str_eq(mneme_core_config_default_vault(ecr), str_from("we\"ird")), "toml escape: quote in default_vault roundtrips");
    assert_eq(vec_len(mneme_core_config_vaults(ecr)), 1, "toml escape: escaped config still parses to 1 vault");
    assert(str_eq(mneme_core_vault_entry_name(vec_get(mneme_core_config_vaults(ecr), 0)), str_from("a\"b")), "toml escape: quote in vault name roundtrips");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
