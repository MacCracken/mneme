# mneme-io PDF-export tests — ported 1:1 from
# rust-old/crates/mneme-io/src/export_pdf.rs (8 test cases).
include "lib/bayan.cyr"        # bayan_pdf_* — the PDF writer since 1.3.0
include "src/io_export_pdf.cyr"

var _pn = 0;
fn _dir(): i64 {
    _pn = _pn + 1;
    var pb = str_builder_new();
    str_builder_add_cstr(pb, "/tmp/mneme_pdf");
    str_builder_add_int(pb, _pn);
    return str_builder_build(pb);
}
fn _cstr(s: Str): i64 {
    var n = str_len(s);
    var buf = alloc(n + 1);
    memcpy(buf, str_data(s), n);
    store8(buf + n, 0);
    return buf;
}
# Read the decimal integer starting at byte `from` — used to check that the
# startxref offset points exactly at the "xref" keyword.
fn _decat(s: Str, from): i64 {
    var n = str_len(s);
    var d = str_data(s);
    var i = from;
    var v = 0;
    while (i < n && load8(d + i) >= 48 && load8(d + i) <= 57) {
        v = v * 10 + load8(d + i) - 48;
        i = i + 1;
    }
    return v;
}
fn _join(a: Str, b): i64 {
    var sb = str_builder_new();
    str_builder_add(sb, a);
    str_builder_putc(sb, 47);
    str_builder_add_cstr(sb, b);
    return str_builder_build(sb);
}

# --- 1.3.0 helpers: read a rendered PDF back through bayan's reader ---
fn _extract(pdf: Str): i64 {
    if (pdf == 0) { return str_from(""); }   # a refused render: let the assertion report it, not a crash
    var doc = bayan_pdf_parse_buf(str_data(pdf), str_len(pdf));
    if (doc == 0) { return str_from(""); }
    return bayan_pdf_extract_text(doc);
}
# the non-empty lines of extracted text
fn _xlines(t: Str): i64 {
    var out = vec_new();
    var n = str_len(t);
    var d = str_data(t);
    var start = 0;
    var i = 0;
    while (i <= n) {
        if (i == n || load8(d + i) == 10) {
            if (i > start) { vec_push(out, str_substr(t, start, i)); }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}
# widest extracted line, in points, measured in `font` at `size` pt
fn _widest(lines, font, size): i64 {
    var w = 0;
    var i = 0;
    while (i < vec_len(lines)) {
        var lw = bayan_pdf_text_width(font, size * 1000, bayan_pdf_winansi(vec_get(lines, i), PDF_WINANSI_SUBSTITUTE, 0));
        if (lw > w) { w = lw; }
        i = i + 1;
    }
    return w / 1000;
}
fn _render(title, body): i64 { return mneme_io_render_pdf(mneme_io_pdf_note_new(str_from(title), str_from(body), vec_new())); }
# the same, for a title and body that are already Strs (str_from wants a C string)
fn _render_s(title: Str, body: Str): i64 { return mneme_io_render_pdf(mneme_io_pdf_note_new(title, body, vec_new())); }
fn _save(pdf: Str, name): i64 {
    var d = _dir();
    sys_mkdir(_cstr(d), 493);
    var p = _join(d, name);
    file_write_all(_cstr(p), str_data(pdf), str_len(pdf));   # pdfcheck.sh validates every /tmp/mneme_pdf*/*.pdf
    return p;
}

fn main() {
    alloc_init();
    test_group("io_export_pdf");

    # parse_heading_blocks
    var b1 = mneme_io_parse_markdown_blocks(str_from("# Title\n\nParagraph text.\n\n## Section"));
    assert_eq(mneme_io_md_block_kind(vec_get(b1, 0)), MD_HEADING, "block0 heading");
    assert_eq(mneme_io_md_block_level(vec_get(b1, 0)), 1, "block0 level 1");
    assert_eq(mneme_io_md_block_kind(vec_get(b1, 2)), MD_PARAGRAPH, "block2 paragraph");
    assert_eq(mneme_io_md_block_kind(vec_get(b1, 4)), MD_HEADING, "block4 heading");
    assert_eq(mneme_io_md_block_level(vec_get(b1, 4)), 2, "block4 level 2");

    # parse_code_block
    var b2 = mneme_io_parse_markdown_blocks(str_from("text\n```\ncode line\n```\nmore text"));
    assert_eq(mneme_io_md_block_kind(vec_get(b2, 1)), MD_CODE, "block1 code");

    # parse_list_items
    var b3 = mneme_io_parse_markdown_blocks(str_from("- item one\n- item two\n* item three"));
    assert_eq(mneme_io_md_block_kind(vec_get(b3, 0)), MD_LISTITEM, "list0");
    assert_eq(mneme_io_md_block_kind(vec_get(b3, 1)), MD_LISTITEM, "list1");
    assert_eq(mneme_io_md_block_kind(vec_get(b3, 2)), MD_LISTITEM, "list2");

    # strip_inline_markdown
    assert_eq(str_eq_cstr(mneme_io_strip_md_inline(str_from("**bold** and *italic*")), "bold and italic"), 1, "strip bold/italic");
    assert_eq(str_eq_cstr(mneme_io_strip_md_inline(str_from("`code`")), "code"), 1, "strip code");
    assert_eq(str_eq_cstr(mneme_io_strip_md_inline(str_from("[link](http://example.com)")), "link"), 1, "strip link");

    # word_wrap
    var w = mneme_io_wrap_text(str_from("hello world this is a test of word wrapping"), 20);
    assert_eq(vec_len(w) > 1, 1, "wrap multiple lines");
    var wok = 1;
    var wi = 0;
    while (wi < vec_len(w)) {
        if (str_len(vec_get(w, wi)) > 25) { wok = 0; }
        wi = wi + 1;
    }
    assert_eq(wok, 1, "wrap lines within slack");

    # export_single_pdf
    var d5 = _dir();
    sys_mkdir(_cstr(d5), 493);
    var note = mneme_io_pdf_note_new(str_from("Test Note"), str_from("# Hello\n\nThis is a **test** note.\n\n## Section\n\n- item 1\n- item 2\n\n```\ncode block\n```"), vec_new());
    var tags5 = mneme_io_pdf_note_tags(note);
    vec_push(tags5, str_from("test"));
    vec_push(tags5, str_from("pdf"));
    var path5 = _join(d5, "test.pdf");
    assert_eq(mneme_io_export_note_to_pdf(note, path5, mneme_io_pdf_options_default()), 0, "single export returns 0 on success");
    assert_eq(file_exists(_cstr(path5)), 1, "single pdf exists");
    var buf = alloc(65536);
    var rn = file_read_all(_cstr(path5), buf, 65536);
    assert_eq(rn > 100, 1, "single pdf > 100 bytes");
    var pdf5 = str_new(buf, rn);
    assert_eq(str_index_of_cstr(pdf5, "%PDF") == 0, 1, "single pdf %PDF header");
    # "exists, >100 bytes, starts with %PDF" passes for almost any garbage, so
    # also pin the structure and the actual note text. bayan's strict validator
    # (scripts/pdfcheck.sh) is the full gate; these are the in-process tripwires.
    assert_eq(str_index_of_cstr(pdf5, "/Type /Catalog") > 0, 1, "single pdf has catalog");
    assert_eq(str_index_of_cstr(pdf5, "/Type /Page") > 0, 1, "single pdf has page object");
    assert_eq(str_index_of_cstr(pdf5, "/BaseFont /Helvetica") > 0, 1, "single pdf has font");
    assert_eq(str_index_of_cstr(pdf5, "trailer") > 0, 1, "single pdf has trailer");
    assert_eq(str_index_of_cstr(pdf5, "%%EOF") > 0, 1, "single pdf has EOF marker");
    # content actually rendered, not just a well-formed empty shell
    assert_eq(str_index_of_cstr(pdf5, "Test Note") > 0, 1, "single pdf contains title text");
    assert_eq(str_index_of_cstr(pdf5, "code block") > 0, 1, "single pdf contains code text");
    # Byte-accurate xref: startxref must land exactly on the "xref" keyword. An
    # off-by-one here is invisible in poppler/mupdf, which rebuild the table by
    # scanning for "N 0 obj" — so only an exact check catches a regression.
    var sx = str_index_of_cstr(pdf5, "startxref");
    assert_eq(sx > 0, 1, "single pdf has startxref");
    var xo = _decat(pdf5, sx + 10);
    assert_eq(xo > 0 && xo < rn, 1, "startxref offset in range");
    assert_eq(memeq(buf + xo, "xref", 4), 1, "startxref offset points at xref keyword");

    # export_multiple_pdfs
    var d6 = _dir();
    var notes = vec_new();
    vec_push(notes, mneme_io_pdf_note_new(str_from("Note One"), str_from("Content one."), vec_new()));
    vec_push(notes, mneme_io_pdf_note_new(str_from("Note Two"), str_from("Content two."), vec_new()));
    assert_eq(mneme_io_export_notes_to_pdf(notes, d6, mneme_io_pdf_options_default()), 2, "multiple count 2");
    assert_eq(file_exists(_cstr(_join(d6, "note-one.pdf"))), 1, "note-one.pdf exists");
    assert_eq(file_exists(_cstr(_join(d6, "note-two.pdf"))), 1, "note-two.pdf exists");

    # export_pdf_with_page_break
    var d7 = _dir();
    sys_mkdir(_cstr(d7), 493);
    var lb = str_builder_new();
    var pi = 0;
    while (pi < 100) {
        if (pi > 0) { str_builder_add_cstr(lb, "\n\n"); }
        str_builder_add_cstr(lb, "This is paragraph number ");
        str_builder_add_int(lb, pi);
        str_builder_add_cstr(lb, " with enough text to fill space.");
        pi = pi + 1;
    }
    var lnote = mneme_io_pdf_note_new(str_from("Long Note"), str_builder_build(lb), vec_new());
    var lpath = _join(d7, "long.pdf");
    assert_eq(mneme_io_export_note_to_pdf(lnote, lpath, mneme_io_pdf_options_default()), 0, "long export returns 0 on success");
    assert_eq(file_exists(_cstr(lpath)), 1, "long pdf exists");

    # ── regression: unterminated ``` fence (docs/adr/015-unterminated-code-fence.md)
    # Input ending mid-fence used to drop code_buf entirely — every line after the
    # stray fence vanished from the PDF with no diagnostic. rust-old has the same
    # bug; this is a deliberate divergence.
    var uf = mneme_io_parse_markdown_blocks(str_from("intro\n```\ncode\nmore code\nTAIL TEXT\n"));
    assert_eq(vec_len(uf), 2, "unterminated fence keeps both blocks");
    # gate the indexed asserts: on a regression the block is missing entirely and
    # a bare vec_get(uf, 1) aborts the whole run instead of reporting a failure
    if (vec_len(uf) == 2) {
        assert_eq(mneme_io_md_block_kind(vec_get(uf, 0)), MD_PARAGRAPH, "unterminated block0 paragraph");
        assert_eq(mneme_io_md_block_kind(vec_get(uf, 1)), MD_CODE, "unterminated tail flushed as code");
        assert_eq(str_index_of_cstr(mneme_io_md_block_text(vec_get(uf, 1)), "TAIL TEXT") >= 0, 1, "unterminated fence keeps trailing text");
    }
    assert_eq(mneme_io_md_unterminated_fence(), 1, "unterminated fence is reported");

    # a properly closed fence must NOT raise the diagnostic
    mneme_io_parse_markdown_blocks(str_from("text\n```\ncode line\n```\nmore text"));
    assert_eq(mneme_io_md_unterminated_fence(), 0, "closed fence is not reported");

    # a bare trailing fence swallows no content — flagged, but no empty block
    var bf = mneme_io_parse_markdown_blocks(str_from("only\n```"));
    assert_eq(vec_len(bf), 1, "bare trailing fence adds no empty block");
    assert_eq(mneme_io_md_unterminated_fence(), 1, "bare trailing fence is reported");

    # ── regression: the flushed tail must reach the PDF bytes, not just the blocks
    var d8 = _dir();
    sys_mkdir(_cstr(d8), 493);
    var fnote = mneme_io_pdf_note_new(str_from("Fence Note"), str_from("intro\n```\ncode\nTAIL TEXT\n"), vec_new());
    var fpath = _join(d8, "fence.pdf");
    assert_eq(mneme_io_export_note_to_pdf(fnote, fpath, mneme_io_pdf_options_default()), 0, "fence note exports");
    var fbuf = alloc(65536);
    var frn = file_read_all(_cstr(fpath), fbuf, 65536);
    assert_eq(str_index_of_cstr(str_new(fbuf, frn), "TAIL TEXT") >= 0, 1, "fence tail present in exported PDF");

    # ── regression: write failures must reach the caller, not report success
    # A regular file cannot be a parent directory, so every path below it fails
    # with ENOTDIR — true on every platform and even when tests run as root,
    # unlike a permission-based or "surely-missing" path.
    var blocker = _join(d8, "blocker");
    file_write_all(_cstr(blocker), str_data(str_from("x")), 1);
    var bad = mneme_io_pdf_note_new(str_from("Bad"), str_from("body"), vec_new());
    assert_eq(mneme_io_export_note_to_pdf(bad, _join(blocker, "x.pdf"), mneme_io_pdf_options_default()) < 0, 1, "single export propagates write failure");
    assert_eq(file_exists(_cstr(_join(blocker, "x.pdf"))), 0, "failed single export wrote nothing");
    var bnotes = vec_new();
    vec_push(bnotes, bad);
    assert_eq(mneme_io_export_notes_to_pdf(bnotes, _join(blocker, "sub"), mneme_io_pdf_options_default()) < 0, 1, "batch export propagates mkdir failure");

    # ── xmkdir_p (stdlib 6.5.7+) replaces a one-level sys_mkdir: nested output
    # dirs now work, and re-exporting into an existing dir is not an error.
    var d9 = _dir();
    var nested = _join(d9, "a/b/c");
    assert_eq(mneme_io_export_notes_to_pdf(notes, nested, mneme_io_pdf_options_default()), 2, "batch export creates nested dirs");
    assert_eq(file_exists(_cstr(_join(nested, "note-one.pdf"))), 1, "nested note-one.pdf exists");
    assert_eq(mneme_io_export_notes_to_pdf(notes, nested, mneme_io_pdf_options_default()), 2, "re-export into existing dir succeeds");

    # ===== 1.3.0: the PDF is bayan's (ADR 017) =====
    # ⛔ encoding: the font dict declares WinAnsiEncoding and the text is transcoded, so non-ASCII text reads
    # back as written. The hand-rolled writer had no /Encoding: `Résumé` rendered `RÃ©sumÃ©`, `—` vanished.
    var penc = _render("Résumé — notes", "Café, naïve and “quoted” — 50 €");
    assert(penc != 0, "accented note renders");
    _save(penc, "encoding.pdf");
    assert_eq(str_index_of_cstr(penc, "/Encoding /WinAnsiEncoding") > 0, 1, "fonts declare WinAnsiEncoding");
    var tenc = _extract(penc);
    assert_eq(str_index_of_cstr(tenc, "Résumé — notes") >= 0, 1, "accented title reads back exactly");
    assert_eq(str_index_of_cstr(tenc, "Café, naïve and “quoted” — 50 €") >= 0, 1, "accents, curly quotes, dash and euro read back");
    assert_eq(mneme_io_pdf_substituted(), 0, "nothing substituted: all of it is WinAnsi");
    assert_eq(mneme_io_pdf_warning(), 0, "a clean note has no warning");
    # fonts: title and headings Helvetica-Bold, code Courier (Rust's printpdf choices; the port used Helvetica only)
    assert_eq(str_index_of_cstr(pdf5, "/BaseFont /Helvetica-Bold") > 0, 1, "title/headings in Helvetica-Bold");
    assert_eq(str_index_of_cstr(pdf5, "/BaseFont /Courier") > 0, 1, "code in Courier");
    assert_eq(str_index_of_cstr(pdf5, "/Title") > 0, 1, "the note title is the document title (/Info)");

    # ⛔ measured wrapping: no line runs past the 451 pt column. By character count, 80 'W's are 831 pt — 308 pt
    # off an A4 page — while 80 'l's are 195 pt.
    var wb = str_builder_new();
    var wi2 = 0;
    while (wi2 < 40) { if (wi2 > 0) { str_builder_putc(wb, 32); } str_builder_add_cstr(wb, "WWWW"); wi2 = wi2 + 1; }
    var pw = _render_s(str_from("Wide"), str_builder_build(wb));
    _save(pw, "wide.pdf");
    var wl = _xlines(_extract(pw));
    assert_eq(_widest(wl, PDF_FONT_HELVETICA, 11) <= 451, 1, "every 'W' line fits the 451 pt column");
    assert_eq(vec_len(wl) >= 5, 1, "199 characters of 'W' take at least 4 body lines (+ the title), not 3");
    var nb = str_builder_new();
    var ni = 0;
    while (ni < 30) { if (ni > 0) { str_builder_putc(nb, 32); } str_builder_add_cstr(nb, "llll"); ni = ni + 1; }
    var nl = _xlines(_extract(_render_s(str_from("Narrow"), str_builder_build(nb))));
    assert_eq(vec_len(nl), 2, "149 characters of 'l' (~382 pt) fit on ONE body line (+ the title) — an 80-char count makes two");
    # a long title wraps too, measured in its own (bold) face
    var tbld = str_builder_new();
    var tbi = 0;
    while (tbi < 20) { if (tbi > 0) { str_builder_putc(tbld, 32); } str_builder_add_cstr(tbld, "Wide"); tbi = tbi + 1; }
    var tl = _xlines(_extract(_render_s(str_builder_build(tbld), str_from("x"))));
    assert_eq(_widest(tl, PDF_FONT_HELVETICA_BOLD, 18) <= 451, 1, "a long title wraps inside the column");

    # ⛔ a CR inside a line becomes a space. The hand-rolled escaper DELETED it, welding "alpha" and "beta".
    var tcr = _extract(_render("CR", "alpha\rbeta and one\ttab"));
    assert_eq(str_index_of_cstr(tcr, "alpha beta") >= 0, 1, "CR becomes a space, the words stay apart");
    assert_eq(str_index_of_cstr(tcr, "alphabeta") < 0, 1, "and are not welded together");
    assert_eq(str_index_of_cstr(tcr, "one tab") >= 0, 1, "a tab becomes a space");

    # a character the standard fonts cannot draw is exported as '?' and reported — never a lost line
    var psub = _render("Checks", "login ✓ ok");
    assert(psub != 0, "a note with ✓ still renders");
    _save(psub, "substituted.pdf");
    assert_eq(str_index_of_cstr(_extract(psub), "login ? ok") >= 0, 1, "✓ is exported as '?' and the line kept");
    assert_eq(mneme_io_pdf_substituted(), 1, "one character substituted");
    assert_eq(str_index_of_cstr(mneme_io_pdf_warning(), "1 character(s)") >= 0, 1, "the warning says so");
    # malformed UTF-8 never reaches bayan (it would refuse the run): the bad byte is '?' and the line kept
    var badb = alloc(8);
    store8(badb, 97); store8(badb + 1, 255); store8(badb + 2, 98); store8(badb + 3, 0);
    var pbad = mneme_io_render_pdf(mneme_io_pdf_note_new(str_from("Bytes"), str_new(badb, 3), vec_new()));
    assert(pbad != 0, "malformed UTF-8 still renders");
    assert_eq(str_index_of_cstr(_extract(pbad), "a?b") >= 0, 1, "the malformed byte is '?'");

    # the unterminated-fence diagnostic is surfaced (ADR 015 recorded it; nothing reported it)
    _render("Fence", "intro\n```\ncode\nTAIL");
    assert_eq(str_index_of_cstr(mneme_io_pdf_warning(), "unclosed ``` fence") >= 0, 1, "an unclosed fence is a warning");
    # ... per note, through the batch exporter
    var wnotes = vec_new();
    vec_push(wnotes, mneme_io_pdf_note_new(str_from("Clean One"), str_from("fine"), vec_new()));
    vec_push(wnotes, mneme_io_pdf_note_new(str_from("Odd One"), str_from("mark ✓"), vec_new()));
    var dw = _dir();
    assert_eq(mneme_io_export_notes_to_pdf(wnotes, dw, mneme_io_pdf_options_default()), 2, "batch with a warning exports both");
    var bw = mneme_io_pdf_batch_warnings();
    assert_eq(vec_len(bw), 1, "one note has a warning");
    assert_eq(str_ends_with(load64(vec_get(bw, 0)), str_from("odd-one.pdf")), 1, "and it is odd-one.pdf");

    # the page break still happens, and every page is a real page (the long note above)
    var lpdf = _render_s(str_from("Long"), mneme_io_pdf_note_content(lnote));
    var ldoc = bayan_pdf_parse_buf(str_data(lpdf), str_len(lpdf));
    assert_eq(bayan_pdf_page_count(ldoc) > 1, 1, "100 paragraphs span more than one page");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
