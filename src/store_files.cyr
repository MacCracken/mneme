# mneme-store — file-backed Markdown storage (ported from rust-old/crates/mneme-store/src/files.rs)
# FileStore over lib/io (file_read_all/write_all/exists) + sys_mkdir/sys_unlink;
# content_hash via sigil sha256; title_to_path is pure. Async #[tokio::test]s → sync.
# Requires: lib/sigil.cyr (sha256), fs (path_join/path_dirname), io, syscalls.

fn _fs_cstr(s: Str): i64 {
    var n = str_len(s);
    var buf = alloc(n + 1);
    memcpy(buf, str_data(s), n);
    store8(buf + n, 0);
    return buf;
}
fn _fs_hexc(nib): i64 { if (nib < 10) { return 48 + nib; } return 87 + nib; }

# mkdir -p: create `dir` and every parent (ignore EEXIST)
fn _fs_mkdir_p(dir: Str): i64 {
    var n = str_len(dir);
    var d = str_data(dir);
    var i = 1;
    while (i <= n) {
        if (i == n || load8(d + i) == 47) {
            sys_mkdir(_fs_cstr(str_substr(dir, 0, i)), 493);   # 0755
        }
        i = i + 1;
    }
    return 0;
}

# FileStore (8 bytes): [notes_dir@0 (Str)]
fn mneme_store_filestore_new(vault_root: Str): i64 {
    var fs = alloc(8);
    store64(fs, path_join(vault_root, str_from("notes")));
    return fs;
}
fn mneme_store_filestore_notes_dir(fs): i64 { return load64(fs); }

fn mneme_store_filestore_init(fs): i64 {
    return _fs_mkdir_p(load64(fs));
}
# Is `rel` a path that stays inside the notes directory? Non-empty, no NUL byte, not absolute (`/` or
# `\\`), and no `..` component (split on `/` and `\\`). 1.2.3 hardening — a DIVERGENCE from rust-old, which
# writes an explicit `CreateNote.path` as given, so `../../x` escaped the vault (audit 2026-07-10 §2;
# ADR 016). A title-derived path is a flat slug and always passes. Every FileStore operation checks it, so a
# path that reached the database some other way cannot escape either.
fn mneme_store_note_path_is_safe(rel: Str): i64 {
    if (rel == 0) { return 0; }
    var n = str_len(rel);
    if (n == 0) { return 0; }
    var d = str_data(rel);
    var c0 = load8(d);
    if (c0 == 47 || c0 == 92) { return 0; }
    var start = 0;
    var i = 0;
    while (i <= n) {
        var c = 0;
        if (i < n) { c = load8(d + i); }
        if (i < n && c == 0) { return 0; }
        if (i == n || c == 47 || c == 92) {
            if (i - start == 2 && load8(d + start) == 46 && load8(d + start + 1) == 46) { return 0; }
            start = i + 1;
        }
        i = i + 1;
    }
    return 1;
}

# read Markdown content, or 0 (NotFound) when the file cannot be opened or read, or `rel` is unsafe.
# 1.2.3: the whole file. This read through a fixed 256 KB `file_read_all` buffer, so a larger note came back
# cut short with no error — and saving it after an edit destroyed the rest. `file_read_whole` grows its
# buffer, and a read that fails part-way is a failure (0), never a prefix.
fn mneme_store_filestore_read_note(fs, rel: Str): i64 {
    if (mneme_store_note_path_is_safe(rel) == 0) { return 0; }
    var full = _fs_cstr(path_join(load64(fs), rel));
    var n = 0;
    var buf = file_read_whole(full, &n);
    if (buf == 0) { return 0; }
    return str_new(buf, n);
}
# write a note: 0 on success, a negative errno on failure (-22 EINVAL for an unsafe `rel`).
# 1.2.3: crash-safe. `file_write_all` truncates at open, so a write that failed part-way (a full disk) left
# an EXISTING note cut short. `file_replace_atomic` writes a temp, fsyncs and renames it over the note, so a
# failure leaves the old note intact; a symlinked note stays a link and its target gets the bytes, as before.
fn mneme_store_filestore_write_note(fs, rel: Str, content: Str): i64 {
    if (mneme_store_note_path_is_safe(rel) == 0) { return 0 - 22; }
    var full = path_join(load64(fs), rel);
    _fs_mkdir_p(path_dirname(full));
    return file_replace_atomic(_fs_cstr(full), str_data(content), str_len(content));
}
# delete; returns 0 on success, negative (e.g. -ENOENT) if not found (-22 for an unsafe `rel`)
fn mneme_store_filestore_delete_note(fs, rel: Str): i64 {
    if (mneme_store_note_path_is_safe(rel) == 0) { return 0 - 22; }
    return sys_unlink(_fs_cstr(path_join(load64(fs), rel)));
}
fn mneme_store_filestore_exists(fs, rel: Str): i64 {
    if (mneme_store_note_path_is_safe(rel) == 0) { return 0; }
    return file_exists(_fs_cstr(path_join(load64(fs), rel)));
}

# SHA-256 of content, hex-encoded (64 chars)
fn mneme_store_content_hash(content: Str): i64 {
    var out = alloc(32);
    sha256(str_data(content), str_len(content), out);
    var sb = str_builder_new();
    var i = 0;
    while (i < 32) {
        var b = load8(out + i);
        str_builder_putc(sb, _fs_hexc((b >> 4) & 15));
        str_builder_putc(sb, _fs_hexc(b & 15));
        i = i + 1;
    }
    return str_builder_build(sb);
}

# title -> "<slug>.md" (alnum->lower, else '-', collapse '-' runs, trim trailing)
fn mneme_store_title_to_path(title: Str): i64 {
    var n = str_len(title);
    var d = str_data(title);
    var tmp = str_builder_new();
    var i = 0;
    while (i < n) {
        var c = load8(d + i);
        if ((c >= 48 && c <= 57) || (c >= 97 && c <= 122)) { str_builder_putc(tmp, c); }
        elif (c >= 65 && c <= 90) { str_builder_putc(tmp, c + 32); }
        else { str_builder_putc(tmp, 45); }
        i = i + 1;
    }
    var mapped = str_builder_build(tmp);
    var mn = str_len(mapped);
    var md = str_data(mapped);
    var out = str_builder_new();
    var start = 0;
    var first = 1;
    var k = 0;
    while (k <= mn) {
        var isend = 0;
        if (k == mn) { isend = 1; }
        elif (load8(md + k) == 45) { isend = 1; }
        if (isend == 1) {
            if (k > start) {
                if (first == 0) { str_builder_putc(out, 45); }
                str_builder_add(out, str_substr(mapped, start, k));
                first = 0;
            }
            start = k + 1;
        }
        k = k + 1;
    }
    str_builder_add_cstr(out, ".md");
    return str_builder_build(out);
}
