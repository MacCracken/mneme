# mneme-io — PDF export (ported from rust-old/crates/mneme-io/src/export_pdf.rs).
# Rust used the `printpdf` crate. Since 1.3.0 the PDF itself is bayan's (`bayan_pdf_*`: objects, xref, fonts,
# content streams, WinAnsi transcoding, measured word wrap); mneme keeps its own markdown layer
# (mneme_io_parse_markdown_blocks, ADR 015) and its layout. See ADR 017.
# Layout is in PDF points (A4 = 595x842); bayan takes milli-points (1 pt = 1000 mpt).
# Requires (include first): lib/bayan.cyr.

enum MdBlock { MD_HEADING; MD_PARAGRAPH; MD_CODE; MD_LISTITEM; MD_EMPTY; }

fn _pdf_cstr(s: Str): i64 {
    var n = str_len(s);
    var buf = alloc(n + 1);
    memcpy(buf, str_data(s), n);
    store8(buf + n, 0);
    return buf;
}
fn _pdf_ws(c): i64 { if (c == 32 || c == 9 || c == 10 || c == 13) { return 1; } return 0; }
fn _pdf_trim(s: Str): i64 {
    var n = str_len(s);
    var d = str_data(s);
    var a = 0;
    while (a < n && _pdf_ws(load8(d + a)) == 1) { a = a + 1; }
    var b = n;
    while (b > a && _pdf_ws(load8(d + b - 1)) == 1) { b = b - 1; }
    return str_substr(s, a, b);
}
fn _pdf_starts(s: Str, pfx): i64 {
    var pl = strlen(pfx);
    if (str_len(s) < pl) { return 0; }
    if (memeq(str_data(s), pfx, pl) == 1) { return 1; }
    return 0;
}
fn _pdf_lines(s: Str): i64 {
    var out = vec_new();
    var n = str_len(s);
    var d = str_data(s);
    var start = 0;
    var i = 0;
    while (i <= n) {
        var isend = 0;
        if (i == n) { isend = 1; } elif (load8(d + i) == 10) { isend = 1; }
        if (isend == 1) { vec_push(out, str_substr(s, start, i)); start = i + 1; }
        i = i + 1;
    }
    return out;
}

# MdBlock (24): [kind@0, level@8, text@16]
fn _pdf_block(kind, level, text): i64 {
    var b = alloc(24);
    store64(b, kind);
    store64(b + 8, level);
    store64(b + 16, text);
    return b;
}
fn mneme_io_md_block_kind(b): i64 { return load64(b); }
fn mneme_io_md_block_level(b): i64 { return load64(b + 8); }
fn mneme_io_md_block_text(b): i64 { return load64(b + 16); }

# strip [text](url) → text (non-links kept)
fn _pdf_strip_links(s: Str): i64 {
    var sb = str_builder_new();
    var n = str_len(s);
    var d = str_data(s);
    var i = 0;
    while (i < n) {
        if (load8(d + i) == 91) {   # '['
            var close = i + 1;
            while (close < n && load8(d + close) != 93) { close = close + 1; }   # ']'
            if (close < n && close + 1 < n && load8(d + close + 1) == 40) {   # '('
                var paren = close + 2;
                while (paren < n && load8(d + paren) != 41) { paren = paren + 1; }   # ')'
                if (paren < n) {
                    str_builder_add(sb, str_substr(s, i + 1, close));
                    i = paren + 1;
                } else { str_builder_putc(sb, 91); i = i + 1; }
            } else { str_builder_putc(sb, 91); i = i + 1; }
        } else { str_builder_putc(sb, load8(d + i)); i = i + 1; }
    }
    return str_builder_build(sb);
}
fn _pdf_replace_all(s: Str, from_cstr, to_cstr): i64 {
    var sb = str_builder_new();
    var flen = strlen(from_cstr);
    var n = str_len(s);
    var d = str_data(s);
    var i = 0;
    while (i < n) {
        if (flen > 0 && i + flen <= n && memeq(d + i, from_cstr, flen) == 1) {
            str_builder_add_cstr(sb, to_cstr);
            i = i + flen;
        } else { str_builder_putc(sb, load8(d + i)); i = i + 1; }
    }
    return str_builder_build(sb);
}
fn _pdf_drop_chars(s: Str): i64 {   # drop * _ `
    var sb = str_builder_new();
    var n = str_len(s);
    var d = str_data(s);
    var i = 0;
    while (i < n) {
        var c = load8(d + i);
        if (c != 42 && c != 95 && c != 96) { str_builder_putc(sb, c); }
        i = i + 1;
    }
    return str_builder_build(sb);
}
fn mneme_io_strip_md_inline(text: Str): i64 {
    var t = _pdf_replace_all(text, "**", "");
    t = _pdf_replace_all(t, "__", "");
    t = _pdf_drop_chars(t);
    return _pdf_strip_links(t);
}

# Set by the last mneme_io_parse_markdown_blocks call: 1 when the input ended
# while a ``` fence was still open. Module-global + accessor rather than an
# out-param, so the parser's signature (and its callers) stay unchanged — the
# same diagnostic idiom as bayan's bayan_json_last_error().
var _pdf_md_unterminated = 0;
fn mneme_io_md_unterminated_fence(): i64 { return _pdf_md_unterminated; }

fn mneme_io_parse_markdown_blocks(md: Str): i64 {
    var blocks = vec_new();
    _pdf_md_unterminated = 0;
    var in_code = 0;
    var code_buf = str_builder_new();
    var lines = _pdf_lines(md);
    var i = 0;
    while (i < vec_len(lines)) {
        var line = vec_get(lines, i);
        if (_pdf_starts(line, "```") == 1) {
            if (in_code == 1) { vec_push(blocks, _pdf_block(MD_CODE, 0, str_builder_build(code_buf))); code_buf = str_builder_new(); in_code = 0; }
            else { in_code = 1; }
        } elif (in_code == 1) {
            str_builder_add(code_buf, line);
            str_builder_putc(code_buf, 10);
        } else {
            var trimmed = _pdf_trim(line);
            if (str_len(trimmed) == 0) { vec_push(blocks, _pdf_block(MD_EMPTY, 0, str_from(""))); }
            elif (_pdf_starts(trimmed, "### ") == 1) { vec_push(blocks, _pdf_block(MD_HEADING, 3, mneme_io_strip_md_inline(str_substr(trimmed, 4, str_len(trimmed))))); }
            elif (_pdf_starts(trimmed, "## ") == 1) { vec_push(blocks, _pdf_block(MD_HEADING, 2, mneme_io_strip_md_inline(str_substr(trimmed, 3, str_len(trimmed))))); }
            elif (_pdf_starts(trimmed, "# ") == 1) { vec_push(blocks, _pdf_block(MD_HEADING, 1, mneme_io_strip_md_inline(str_substr(trimmed, 2, str_len(trimmed))))); }
            elif (_pdf_starts(trimmed, "- ") == 1) { vec_push(blocks, _pdf_block(MD_LISTITEM, 0, mneme_io_strip_md_inline(str_substr(trimmed, 2, str_len(trimmed))))); }
            elif (_pdf_starts(trimmed, "* ") == 1) { vec_push(blocks, _pdf_block(MD_LISTITEM, 0, mneme_io_strip_md_inline(str_substr(trimmed, 2, str_len(trimmed))))); }
            else { vec_push(blocks, _pdf_block(MD_PARAGRAPH, 0, mneme_io_strip_md_inline(trimmed))); }
        }
        i = i + 1;
    }
    # Unterminated ``` fence: the loop ends with in_code still 1 and code_buf
    # holding every line after the stray fence. Both Rust (printpdf port) and
    # this port used to drop that buffer on the floor — the rest of the note
    # vanished from the PDF with no diagnostic. Flush it as a code block, the
    # same shape a closing fence would have produced, and record the
    # unterminated state so callers can warn. Deliberate divergence from
    # rust-old — see docs/adr/015-unterminated-code-fence.md.
    if (in_code == 1) {
        _pdf_md_unterminated = 1;
        var tail = str_builder_build(code_buf);
        # Only emit a block when the fence actually swallowed content; a bare
        # trailing "```" loses nothing and should not add an empty code block.
        if (str_len(tail) > 0) { vec_push(blocks, _pdf_block(MD_CODE, 0, tail)); }
    }
    return blocks;
}

# Rust's wrap_text: greedy word wrap by CHARACTER COUNT. Kept for rust-old's `word_wrap` test only — since 1.3.0
# the renderer wraps by measured width (bayan_pdf_wrap), because a character count says almost nothing about
# how wide a line of proportional text is (ADR 017).
fn mneme_io_wrap_text(text: Str, max_width): i64 {
    var out = vec_new();
    if (str_len(text) <= max_width) { vec_push(out, text); return out; }
    var n = str_len(text);
    var d = str_data(text);
    # split into words, then greedily fill lines
    var words = vec_new();
    var start = 0;
    var i = 0;
    while (i <= n) {
        var e2 = 0;
        if (i == n) { e2 = 1; } elif (_pdf_ws(load8(d + i)) == 1) { e2 = 1; }
        if (e2 == 1) {
            if (i > start) { vec_push(words, str_substr(text, start, i)); }
            start = i + 1;
        }
        i = i + 1;
    }
    var line = 0;   # a Str; untyped because it is reassigned from vec_get
    line = str_from("");
    var w = 0;
    while (w < vec_len(words)) {
        var word = vec_get(words, w);
        if (str_len(line) == 0) { line = word; }
        elif (str_len(line) + 1 + str_len(word) > max_width) { vec_push(out, line); line = word; }
        else {
            var sb = str_builder_new();
            str_builder_add(sb, line);
            str_builder_putc(sb, 32);
            str_builder_add(sb, word);
            line = str_builder_build(sb);
        }
        w = w + 1;
    }
    if (str_len(line) > 0) { vec_push(out, line); }
    return out;
}

fn mneme_io_pdf_slug(s: Str): i64 {
    var sb = str_builder_new();
    var n = str_len(s);
    var d = str_data(s);
    var prev_dash = 1;
    var i = 0;
    while (i < n) {
        var c = load8(d + i);
        var isaln = 0;
        if ((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)) { isaln = 1; }
        if (isaln == 1) {
            if (c >= 65 && c <= 90) { c = c + 32; }
            str_builder_putc(sb, c);
            prev_dash = 0;
        } else {
            if (prev_dash == 0) { str_builder_putc(sb, 45); prev_dash = 1; }
        }
        i = i + 1;
    }
    var res = str_builder_build(sb);
    var rn = str_len(res);
    while (rn > 0 && load8(str_data(res) + rn - 1) == 45) { rn = rn - 1; }
    return str_substr(res, 0, rn);
}

# PdfNote (24): [title@0, content_md@8, tags@16(vec)]
fn mneme_io_pdf_note_new(title, content_md, tags): i64 {
    var n = alloc(24);
    store64(n, title);
    store64(n + 8, content_md);
    store64(n + 16, tags);
    return n;
}
fn mneme_io_pdf_note_title(n): i64 { return load64(n); }
fn mneme_io_pdf_note_content(n): i64 { return load64(n + 8); }
fn mneme_io_pdf_note_tags(n): i64 { return load64(n + 16); }
fn mneme_io_pdf_options_default(): i64 { return 0; }   # layout constants hardcoded (A4)

# --- PDF assembly on bayan_pdf_* (1.3.0, ADR 017) ---------------------------------------------------------
# Until 1.2.x this file hand-rolled the PDF: a Type1 font dict with NO /Encoding (so viewers fell back to
# StandardEncoding and `Résumé` rendered `RÃ©sumÃ©`), wrapping by character COUNT (80 `W` ran 308 pt off an
# A4 page), a show-text escaper that silently DELETED CR/LF (welding the words either side together), and an
# xref built from a predicted `offset = 9` and closed-form object numbers. bayan's writer measures offsets off
# its builder, declares /WinAnsiEncoding and transcodes, and wraps by real AFM widths.

# Geometry, in points — unchanged from the hand-rolled writer.
var _PDFM_LEFT      = 72;    # body text x
var _PDFM_LIST_LEFT = 78;    # list items: 72 + the width of the old "  " indent (bayan's wrap drops leading spaces)
var _PDFM_CODE_LEFT = 87;    # code x (Rust: margin + 5 mm)
var _PDFM_TOP       = 770;   # first baseline of a page
var _PDFM_BOTTOM    = 90;    # a line that would sit below this starts a new page
var _PDFM_COLUMN    = 451;   # 595 - 72 - 72: the MEASURED wrap width

# Diagnostics of the most recent render (module globals + accessors, like mneme_io_md_unterminated_fence).
var _pdfm_substituted = 0;   # characters with no glyph in the standard fonts, exported as '?'
var _pdfm_failed = 0;        # text runs bayan refused (0 unless this file has a bug — the text is prepared)
var _pdfm_error = 0;         # bayan's reason when a render fails (a cstr), else 0
fn mneme_io_pdf_substituted(): i64 { return _pdfm_substituted; }
fn mneme_io_pdf_error(): i64 { return _pdfm_error; }

# One UTF-8 sequence starting at `i` is well formed (RFC 3629: no overlongs, no surrogates, <= U+10FFFF)?
# Returns its length, or 0.
fn _pdfm_cont(d, i, n): i64 {
    if (i >= n) { return 0; }
    var c = load8(d + i);
    if (c >= 128 && c <= 191) { return 1; }
    return 0;
}
fn _pdfm_utf8_len(d, i, n): i64 {
    var b = load8(d + i);
    if (b < 128) { return 1; }
    if (b >= 194 && b <= 223) { if (_pdfm_cont(d, i + 1, n) == 1) { return 2; } return 0; }
    if (b >= 224 && b <= 239) {
        if (i + 2 >= n) { return 0; }
        var b1 = load8(d + i + 1);
        if (b == 224 && (b1 < 160 || b1 > 191)) { return 0; }   # overlong
        if (b == 237 && (b1 < 128 || b1 > 159)) { return 0; }   # UTF-16 surrogate
        if (_pdfm_cont(d, i + 1, n) == 1 && _pdfm_cont(d, i + 2, n) == 1) { return 3; }
        return 0;
    }
    if (b >= 240 && b <= 244) {
        if (i + 3 >= n) { return 0; }
        var c1 = load8(d + i + 1);
        if (b == 240 && (c1 < 144 || c1 > 191)) { return 0; }   # overlong
        if (b == 244 && (c1 < 128 || c1 > 143)) { return 0; }   # past U+10FFFF
        if (_pdfm_cont(d, i + 1, n) == 1 && _pdfm_cont(d, i + 2, n) == 1 && _pdfm_cont(d, i + 3, n) == 1) { return 4; }
        return 0;
    }
    return 0;
}
# `s` with every C0 control and DEL turned into a space (a show-text run cannot hold a line break — bayan
# refuses CR/LF — and has no glyph for the rest) and every malformed UTF-8 byte into '?' (counted).
fn _pdfm_clean(s: Str): i64 {
    var n = str_len(s);
    var d = str_data(s);
    var sb = str_builder_new();
    var i = 0;
    while (i < n) {
        var c = load8(d + i);
        if (c < 32 || c == 127) { str_builder_putc(sb, 32); i = i + 1; }
        elif (c < 128) { str_builder_putc(sb, c); i = i + 1; }
        else {
            var k = _pdfm_utf8_len(d, i, n);
            if (k == 0) { str_builder_putc(sb, 63); _pdfm_substituted = _pdfm_substituted + 1; i = i + 1; }
            else {
                var j = 0;
                while (j < k) { str_builder_putc(sb, load8(d + i + j)); j = j + 1; }
                i = i + k;
            }
        }
    }
    return str_builder_build(sb);
}
# UTF-8 text -> WinAnsi bytes, ready to measure and draw. A character WinAnsi cannot name (CJK, emoji, ✓) is
# exported as '?' and counted; nothing is dropped. If bayan still refuses the cleaned text, every non-ASCII
# byte becomes '?' (ASCII always encodes), so a line is never lost.
fn _pdfm_winansi(s: Str): i64 {
    var clean = _pdfm_clean(s);
    var st[16];
    var wa = bayan_pdf_winansi(clean, PDF_WINANSI_SUBSTITUTE, &st);
    if (wa != 0) {
        _pdfm_substituted = _pdfm_substituted + load64(&st);
        return wa;
    }
    var sb = str_builder_new();
    var n = str_len(clean);
    var d = str_data(clean);
    var i = 0;
    while (i < n) {
        var c = load8(d + i);
        if (c >= 128) { str_builder_putc(sb, 63); _pdfm_substituted = _pdfm_substituted + 1; }
        else { str_builder_putc(sb, c); }
        i = i + 1;
    }
    return str_builder_build(sb);
}

# Flow (24): [doc@0, page@8 (0 = none yet), y@16 (pt)]
fn _pdfm_flow_new(doc): i64 {
    var f = alloc(24);
    store64(f, doc);
    store64(f + 8, 0);
    store64(f + 16, _PDFM_TOP);
    return f;
}
fn _pdfm_y(f): i64 { return load64(f + 16); }
fn _pdfm_down(f, pts): i64 { store64(f + 16, load64(f + 16) - pts); return 0; }
# the page the next line goes on: a new one when there is none yet or the cursor is below the bottom margin
fn _pdfm_room(f): i64 {
    if (load64(f + 8) == 0 || load64(f + 16) < _PDFM_BOTTOM) {
        var doc = load64(f);
        store64(f + 8, bayan_pdf_add_page(doc, bayan_pdf_page_size_w(PDF_PAGE_A4), bayan_pdf_page_size_h(PDF_PAGE_A4)));
        store64(f + 16, _PDFM_TOP);
    }
    return load64(f + 8);
}
# draw one already-WinAnsi line at the cursor (the cursor does not move)
fn _pdfm_draw(f, font, size, x, wa_line: Str): i64 {
    var pg = _pdfm_room(f);
    if (pg == 0) { _pdfm_failed = _pdfm_failed + 1; return 0 - 1; }
    # text_at takes UTF-8 and re-encodes it STRICTLY; the line is WinAnsi-clean, so decode it back first.
    if (bayan_pdf_text_at(pg, font, size * 1000, x * 1000, load64(f + 16) * 1000, bayan_pdf_from_winansi(wa_line)) != 0) {
        _pdfm_failed = _pdfm_failed + 1;
        return 0 - 1;
    }
    return 0;
}
# `text` (UTF-8) wrapped by MEASURED width into `width` points: each line drawn, the cursor moving `lead`
# points after every line. Returns the number of lines.
fn _pdfm_para(f, font, size, x, width, lead, text: Str): i64 {
    var lines = bayan_pdf_wrap(font, size * 1000, width * 1000, _pdfm_winansi(text));
    var i = 0;
    while (i < vec_len(lines)) {
        _pdfm_draw(f, font, size, x, vec_get(lines, i));
        _pdfm_down(f, lead);
        i = i + 1;
    }
    return vec_len(lines);
}

fn mneme_io_render_pdf(note): i64 {
    _pdfm_substituted = 0;
    _pdfm_failed = 0;
    _pdfm_error = 0;
    var doc = bayan_pdf_new();
    if (doc == 0) { _pdfm_error = "could not create the PDF document"; return 0; }
    var title = mneme_io_pdf_note_title(note);
    # the document title (Rust: PdfDocument::new(&note.title, ..)), from the same prepared text as the page
    bayan_pdf_set_info(doc, "Title", bayan_pdf_from_winansi(_pdfm_winansi(title)));
    var f = _pdfm_flow_new(doc);

    # Title — Helvetica-Bold 18 (Rust: font_helvetica_bold). Wrapped, so a long title stays on the page.
    _pdfm_para(f, PDF_FONT_HELVETICA_BOLD, 18, _PDFM_LEFT, _PDFM_COLUMN, 22, title);
    _pdfm_down(f, 8);   # 22 + 8 = the old single-line title's 30 pt
    var tags = mneme_io_pdf_note_tags(note);
    if (vec_len(tags) > 0) {
        var tb = str_builder_new();
        var ti = 0;
        while (ti < vec_len(tags)) {
            if (ti > 0) { str_builder_add_cstr(tb, "  "); }
            str_builder_putc(tb, 35);
            str_builder_add(tb, vec_get(tags, ti));
            ti = ti + 1;
        }
        _pdfm_para(f, PDF_FONT_HELVETICA, 10, _PDFM_LEFT, _PDFM_COLUMN, 14, str_builder_build(tb));
        _pdfm_down(f, 10);   # 14 + 10 = the old 24 pt
    }
    _pdfm_down(f, 8);
    var blocks = mneme_io_parse_markdown_blocks(mneme_io_pdf_note_content(note));
    var i = 0;
    while (i < vec_len(blocks)) {
        var b = vec_get(blocks, i);
        var k = mneme_io_md_block_kind(b);
        if (k == MD_HEADING) {
            var size = 18;
            if (mneme_io_md_block_level(b) == 2) { size = 15; }
            if (mneme_io_md_block_level(b) >= 3) { size = 13; }
            _pdfm_down(f, 8);
            _pdfm_para(f, PDF_FONT_HELVETICA_BOLD, size, _PDFM_LEFT, _PDFM_COLUMN, size + 6, mneme_io_md_block_text(b));
        } elif (k == MD_PARAGRAPH) {
            _pdfm_para(f, PDF_FONT_HELVETICA, 11, _PDFM_LEFT, _PDFM_COLUMN, 16, mneme_io_md_block_text(b));
            _pdfm_down(f, 5);
        } elif (k == MD_CODE) {
            # Courier 10 (Rust: font_courier), one line per source line, not wrapped — as in Rust.
            var clines = _pdf_lines(mneme_io_md_block_text(b));
            var ci = 0;
            while (ci < vec_len(clines)) {
                if (str_len(vec_get(clines, ci)) > 0) {
                    _pdfm_draw(f, PDF_FONT_COURIER, 10, _PDFM_CODE_LEFT, _pdfm_winansi(vec_get(clines, ci)));
                    _pdfm_down(f, 16);
                }
                ci = ci + 1;
            }
            _pdfm_down(f, 5);
        } elif (k == MD_LISTITEM) {
            var bt = str_builder_new();
            str_builder_add_cstr(bt, "* ");
            str_builder_add(bt, mneme_io_md_block_text(b));
            _pdfm_para(f, PDF_FONT_HELVETICA, 11, _PDFM_LIST_LEFT, _PDFM_COLUMN - (_PDFM_LIST_LEFT - _PDFM_LEFT), 16, str_builder_build(bt));
        } else {
            _pdfm_down(f, 8);
        }
        i = i + 1;
    }
    _pdfm_room(f);   # a note with no text at all still gets its one page
    # ⛔ bayan's writer still produces bytes after refusing a text run (its open issue, "gap 1"), so a refusal
    # is checked here: a PDF with a line missing is a failed export, never a success.
    if (_pdfm_failed > 0 || bayan_pdf_doc_error_count(doc) > 0) {
        _pdfm_error = bayan_pdf_doc_error(doc);
        if (_pdfm_error == 0) { _pdfm_error = "a line of the note could not be written to the PDF"; }
        return 0;
    }
    var bytes = bayan_pdf_to_bytes(doc);
    if (bytes == 0 || str_len(bytes) == 0) {
        _pdfm_error = bayan_pdf_doc_error(doc);
        if (_pdfm_error == 0) { _pdfm_error = "the PDF could not be serialized"; }
        return 0;
    }
    return bytes;
}

# What a reader of the last rendered PDF should be told, or 0 when nothing: an unterminated ``` fence (the rest
# of the note was exported as code — ADR 015) and characters exported as '?'. 1.3.0: nothing surfaced either.
fn mneme_io_pdf_warning(): i64 {
    var fence = mneme_io_md_unterminated_fence();
    if (fence == 0 && _pdfm_substituted == 0) { return 0; }
    var sb = str_builder_new();
    if (fence == 1) { str_builder_add_cstr(sb, "the note ends inside an unclosed ``` fence; everything after it was exported as code"); }
    if (_pdfm_substituted > 0) {
        if (fence == 1) { str_builder_add_cstr(sb, "; "); }
        str_builder_add_int(sb, _pdfm_substituted);
        str_builder_add_cstr(sb, " character(s) have no glyph in the PDF's standard fonts and were exported as '?'");
    }
    return str_builder_build(sb);
}

# convenience wrapper used by the API's /export/pdf endpoint
fn mneme_io_export_pdf(title, content): i64 {
    return mneme_io_render_pdf(mneme_io_pdf_note_new(title, content, vec_new()));
}

# Returns 0 when the whole PDF reached disk, else a negative error: the negative
# errno from open/write, or -5 (EIO) for a short write. Previously the
# file_write_all result was discarded and 0 returned unconditionally, so a full
# disk, an unwritable path and a missing directory all reported success while
# the note silently never landed. Rust returned Result<(), IoError> here.
fn mneme_io_export_note_to_pdf(note, path: Str, options): i64 {
    var pdf = mneme_io_render_pdf(note);
    if (pdf == 0) { return 0 - 22; }   # EINVAL: the note could not be rendered (mneme_io_pdf_error says why)
    var len = str_len(pdf);
    var wrote = file_write_all(_pdf_cstr(path), str_data(pdf), len);
    if (wrote < 0) { return wrote; }
    # A short write is not an errno path — the file exists but is a truncated,
    # unopenable PDF, which must not read as success.
    if (wrote != len) { return 0 - 5; }
    return 0;
}
# Returns the number of notes written, or a negative error from the first
# failure (directory creation, or any note's write) — matching Rust's `?` on
# create_dir_all + export_note_to_pdf. Previously sys_mkdir's result was
# discarded and count incremented per attempt, so an uncreatable output
# directory reported every note as exported with nothing on disk.
# xmkdir_p (stdlib 6.5.7+) is create_dir_all's equivalent: it builds missing
# parents and treats an existing directory as success, where the bare sys_mkdir
# it replaces created only one level and failed with EEXIST on a re-export.
# The warnings of the last batch: a vec of [path@0 (Str), warning@8 (Str)], one per note that had any.
var _pdfm_batch_warnings = 0;
fn mneme_io_pdf_batch_warnings(): i64 {
    if (_pdfm_batch_warnings == 0) { _pdfm_batch_warnings = vec_new(); }
    return _pdfm_batch_warnings;
}
fn mneme_io_export_notes_to_pdf(notes, dir: Str, options): i64 {
    _pdfm_batch_warnings = vec_new();
    var mk = xmkdir_p(_pdf_cstr(dir), 493);
    if (mk < 0) { return mk; }
    var count = 0;
    var i = 0;
    while (i < vec_len(notes)) {
        var note = vec_get(notes, i);
        var pb = str_builder_new();
        str_builder_add(pb, dir);
        str_builder_putc(pb, 47);
        str_builder_add(pb, mneme_io_pdf_slug(mneme_io_pdf_note_title(note)));
        str_builder_add_cstr(pb, ".pdf");
        var npath = str_builder_build(pb);
        var wr = mneme_io_export_note_to_pdf(note, npath, options);
        if (wr < 0) { return wr; }
        var warn = mneme_io_pdf_warning();
        if (warn != 0) {
            var wp = alloc(16);
            store64(wp, npath);
            store64(wp + 8, warn);
            vec_push(_pdfm_batch_warnings, wp);
        }
        count = count + 1;
        i = i + 1;
    }
    return count;
}
