# mneme-io — Obsidian vault importer (ported from rust-old/crates/mneme-io/src/import_obsidian.rs)
# Walks .md files, parses frontmatter, converts [[wikilinks]], pulls inline #tags.
# Async #[tokio::test]s → sync. Requires core_frontmatter + io_wikilink + fs/io/syscalls.

# ImportedNote (56): [title@0, content@8, tags@16, source_path@24, relative_path@32, wikilinks@40, modified_at@48]
fn mneme_io_imported_note_title(x): i64 { return load64(x); }
fn mneme_io_imported_note_content(x): i64 { return load64(x + 8); }
fn mneme_io_imported_note_tags(x): i64 { return load64(x + 16); }
fn mneme_io_imported_note_source_path(x): i64 { return load64(x + 24); }
fn mneme_io_imported_note_relative_path(x): i64 { return load64(x + 32); }
fn mneme_io_imported_note_wikilinks(x): i64 { return load64(x + 40); }

# ImportStats (32): [notes_found@0, notes_imported@8, wikilinks_converted@16, errors@24 (vec of import errors)]
fn mneme_io_import_stats_notes_found(s): i64 { return load64(s); }
fn mneme_io_import_stats_notes_imported(s): i64 { return load64(s + 8); }
fn mneme_io_import_stats_wikilinks_converted(s): i64 { return load64(s + 16); }
fn mneme_io_import_stats_errors(s): i64 { return load64(s + 24); }
# An import error (16): [path@0 (Str), message@8 (Str)] — Rust's `(PathBuf, String)` in `stats.errors`.
# Shared by the Obsidian, Markdown and Notion importers.
fn mneme_io_import_error_path(e): i64 { return load64(e); }
fn mneme_io_import_error_message(e): i64 { return load64(e + 8); }
fn _imp_error(path: Str, rerr): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "read failed (errno ");
    str_builder_add_int(sb, 0 - rerr);
    str_builder_add_cstr(sb, ")");
    var e = alloc(16);
    store64(e, path);
    store64(e + 8, str_builder_build(sb));
    return e;
}
# Read a whole file for import: the buffer, with `*len_out` = its length; or 0 with `*len_out` = the
# negative errno. 1.2.3: the importers read through a fixed 256 KB `file_read_all` buffer, so a larger note
# was imported cut short, and a read ERROR (`n < 0`) was turned into an empty note and counted as imported.
fn _imp_read_whole(path: Str, len_out): i64 {
    return file_read_whole(_imp_cstr(path), len_out);
}
# import result (16): [notes@0 (vec<ImportedNote>), stats@8]
fn mneme_io_import_result_notes(r): i64 { return load64(r); }
fn mneme_io_import_result_stats(r): i64 { return load64(r + 8); }

fn _imp_cstr(s: Str): i64 {
    var n = str_len(s);
    var buf = alloc(n + 1);
    memcpy(buf, str_data(s), n);
    store8(buf + n, 0);
    return buf;
}
fn _imp_is_ws(c): i64 { if (c == 32 || c == 9 || c == 10 || c == 13) { return 1; } return 0; }
fn _imp_is_tagchar(c): i64 {
    if ((c >= 48 && c <= 57) || (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 47 || c == 45) { return 1; }
    return 0;
}
# Sort file paths the way Rust's `Vec<PathBuf>::sort` does: COMPONENT by component, which for paths without
# empty components is byte order with '/' ranked below every other byte ("a/b" < "a-b"). Stable insertion
# sort. Shared by the three importers. 1.2.3: a byte compare, so io_obsidian and io_markdown put "a-b.md" first.
fn _imp_path_byte(c): i64 { if (c == 47) { return 0 - 1; } return c; }
fn _imp_path_lt(a: Str, b: Str): i64 {
    var la = str_len(a);
    var lb = str_len(b);
    var da = str_data(a);
    var db = str_data(b);
    var n = la;
    if (lb < la) { n = lb; }
    var i = 0;
    while (i < n) {
        var ca = _imp_path_byte(load8(da + i));
        var cb = _imp_path_byte(load8(db + i));
        if (ca < cb) { return 1; }
        if (ca > cb) { return 0; }
        i = i + 1;
    }
    if (la < lb) { return 1; }
    return 0;
}
fn _imp_sort(v): i64 {
    var n = vec_len(v);
    var i = 1;
    while (i < n) {
        var cur = vec_get(v, i);
        var j = i;
        while (j > 0 && _imp_path_lt(cur, vec_get(v, j - 1)) == 1) {
            vec_set(v, j, vec_get(v, j - 1));
            j = j - 1;
        }
        vec_set(v, j, cur);
        i = i + 1;
    }
    return 0;
}
fn _imp_file_stem(path: Str): i64 {
    var base = path_basename(path);
    var bl = str_len(base);
    var bd = str_data(base);
    var dot = 0 - 1;
    var i = 0;
    while (i < bl) { if (load8(bd + i) == 46) { dot = i; } i = i + 1; }
    if (dot < 0) { return base; }
    return str_substr(base, 0, dot);
}
fn _imp_relative(vault_root: Str, full: Str): i64 {
    var vl = str_len(vault_root);
    if (str_len(full) > vl && str_starts_with(full, vault_root) == 1) {
        var rel = str_substr(full, vl, str_len(full));
        if (str_len(rel) > 0 && load8(str_data(rel)) == 47) { rel = str_substr(rel, 1, str_len(rel)); }
        return rel;
    }
    return full;
}
fn _imp_trim_tag(s: Str): i64 {
    var n = str_len(s);
    var d = str_data(s);
    var start = 0;
    while (start < n && _imp_is_tagchar(load8(d + start)) == 0) { start = start + 1; }
    var end = n;
    while (end > start && _imp_is_tagchar(load8(d + end - 1)) == 0) { end = end - 1; }
    return str_substr(s, start, end);
}
fn _imp_tags_has(tags, s: Str): i64 {
    var i = 0;
    while (i < vec_len(tags)) { if (str_eq(vec_get(tags, i), s) == 1) { return 1; } i = i + 1; }
    return 0;
}
# extract Obsidian inline #tags from body, appending new ones to `tags`
fn _imp_inline_tags(body: Str, tags): i64 {
    var n = str_len(body);
    var d = str_data(body);
    var i = 0;
    while (i < n) {
        while (i < n && _imp_is_ws(load8(d + i)) == 1) { i = i + 1; }
        var start = i;
        while (i < n && _imp_is_ws(load8(d + i)) == 0) { i = i + 1; }
        if (i > start) {
            var word = str_substr(body, start, i);
            if (str_len(word) > 0 && load8(str_data(word)) == 35) {   # '#'
                var tag = _imp_trim_tag(str_substr(word, 1, str_len(word)));
                if (str_len(tag) > 0 && _imp_tags_has(tags, tag) == 0) { vec_push(tags, tag); }
            }
        }
    }
    return 0;
}

# Rust's walkers skip every ENTRY whose name starts with '.' (Obsidian's also skips `node_modules`), so a
# skipped directory's whole subtree is skipped. Over a full stdlib walk that is: drop a file when any component
# of its path BELOW the root is skipped. The root itself is never tested, as in Rust. Shared by the three
# importers. 1.2.3: io_obsidian and io_markdown filtered nothing, so `.trash/*.md` (deleted Obsidian notes) and
# `.obsidian/plugins/*/README.md` were imported as notes.
fn _imp_skipped_below_root(rel: Str, skip_node_modules): i64 {
    var n = str_len(rel);
    var d = str_data(rel);
    var start = 0;
    var i = 0;
    while (i <= n) {
        if (i == n || load8(d + i) == 47) {
            if (i > start && load8(d + start) == 46) { return 1; }
            if (skip_node_modules == 1 && i - start == 12 && memeq(d + start, "node_modules", 12) == 1) { return 1; }
            start = i + 1;
        }
        i = i + 1;
    }
    return 0;
}
# the walk's files that end in `ext` and are not skipped (see above), sorted
fn _imp_collect(root: Str, ext, skip_node_modules): i64 {
    var all = find_files(root, str_from(ext));
    var out = vec_new();
    var i = 0;
    while (i < vec_len(all)) {
        var p = vec_get(all, i);
        if (_imp_skipped_below_root(_imp_relative(root, p), skip_node_modules) == 0) { vec_push(out, p); }
        i = i + 1;
    }
    _imp_sort(out);
    return out;
}
# One note, or 0 with `*rerr_out` = the negative errno when the file cannot be read (Rust: Err, which the
# caller records in stats.errors).
fn _imp_single(vault_root: Str, file_path: Str, convert, rerr_out): i64 {
    var n = 0;
    var buf = _imp_read_whole(file_path, &n);
    if (buf == 0) { store64(rerr_out, n); return 0; }
    var raw = str_new(buf, n);
    var pair = mneme_core_frontmatter_split(raw);
    var yaml = mneme_core_fm_pair_yaml(pair);
    var body = mneme_core_fm_pair_body(pair);
    var title = 0;
    var tags = vec_new();
    if (yaml != 0) {
        var fm = mneme_core_frontmatter_parse(yaml);
        title = mneme_core_fm_title(fm);
        var ft = mneme_core_fm_tags(fm);
        var i = 0;
        while (i < vec_len(ft)) { vec_push(tags, vec_get(ft, i)); i = i + 1; }
    }
    if (title == 0) { title = _imp_file_stem(file_path); }
    var wl = mneme_io_extract_wikilinks(body);
    var wtargets = vec_new();
    var wi = 0;
    while (wi < vec_len(wl)) { vec_push(wtargets, mneme_io_wikilink_target(vec_get(wl, wi))); wi = wi + 1; }
    var content = body;
    if (convert == 1) { content = mneme_io_wikilinks_to_markdown(body); }
    _imp_inline_tags(body, tags);
    var note = alloc(56);
    store64(note, title);
    store64(note + 8, content);
    store64(note + 16, tags);
    store64(note + 24, file_path);
    store64(note + 32, _imp_relative(vault_root, file_path));
    store64(note + 40, wtargets);
    store64(note + 48, 0);
    return note;
}

# import all .md files from an Obsidian vault dir; 0 = SourceNotFound
fn mneme_io_import_obsidian_vault(vault_path: Str, convert): i64 {
    if (is_dir(vault_path) == 0) { return 0; }
    var md_files = _imp_collect(vault_path, ".md", 1);   # Rust: skip dot-entries and node_modules
    var notes = vec_new();
    var errors = vec_new();
    var wlconv = 0;
    var i = 0;
    while (i < vec_len(md_files)) {
        var rerr = 0;
        var note = _imp_single(vault_path, vec_get(md_files, i), convert, &rerr);
        if (note == 0) { vec_push(errors, _imp_error(vec_get(md_files, i), rerr)); }
        else {
            wlconv = wlconv + vec_len(mneme_io_imported_note_wikilinks(note));
            vec_push(notes, note);
        }
        i = i + 1;
    }
    var stats = alloc(32);
    store64(stats, vec_len(md_files));
    store64(stats + 8, vec_len(notes));
    store64(stats + 16, wlconv);
    store64(stats + 24, errors);
    var result = alloc(16);
    store64(result, notes);
    store64(result + 8, stats);
    return result;
}
