# mneme-search — build the full-text index from a vault (1.2.3).
#
# Rust reopens its persisted Tantivy index at `.mneme/search-index`, so a restarted mneme searches the notes it
# already has. mneme's index (search_engine) is in memory, and until 1.2.3 nothing seeded it: TUI search always
# reported "0 result(s)", and the API and `mneme serve` found only notes created in the current process. Each
# place that opens a vault's engines now rebuilds the index from the vault with this.
#
# Requires (include first): store_db, store_files, store_vault (the vault), search_engine (the index), and
# core_frontmatter.

# Index every note of `vault` into the full-text `engine`. Returns the number of notes indexed. A note whose file
# cannot be read is skipped (get_note would fail on it too). It reads each file directly instead of calling
# mneme_store_vault_get_note, because get_note TOUCHES last_accessed — a rebuild must not mark every note as just
# opened (the temporal analysis reads that column).
fn mneme_search_engine_index_vault(engine, vault): i64 {
    if (engine == 0 || vault == 0) { return 0; }
    var db = mneme_store_vault_db(vault);
    var files = load64(vault + 8);
    var notes = mneme_store_vault_list_notes(vault, mneme_store_vault_count_notes(vault), 0);
    var indexed = 0;
    var i = 0;
    while (i < vec_len(notes)) {
        var note = vec_get(notes, i);
        var doc = mneme_store_filestore_read_note(files, mneme_core_note_path(note));
        if (doc != 0) {
            var body = mneme_core_fm_pair_body(mneme_core_frontmatter_split(doc));
            var tags = mneme_store_db_get_note_tags(db, mneme_core_note_id(note));
            mneme_search_engine_index_note(engine, mneme_core_note_id(note), mneme_core_note_title(note), body, tags, mneme_core_note_path(note));
            indexed = indexed + 1;
        }
        i = i + 1;
    }
    return indexed;
}
